---
import Layout from '../layouts/Layout.astro';

const phone = "866-891-9778";
const city = "Severna Park";
const niche = "Tree Removal";
const serviceImage = "https://images.unsplash.com/photo-1544070282-591d487c647b?auto=format&fit=crop&w=1200&q=80";
const truckImage = "https://sc02.alicdn.com/kf/Afe3aa9e81b0e495a85667f4139b9cf639.png";
---

<Layout 
	title={`${city.toUpperCase()} MD ${niche.toUpperCase()} | Locally Owned Maryland Septic Service Pros`}
	phone={phone}
	city={city}
	niche={niche}
>
	<!-- 1. HERO SECTION (Golden Template Standard) -->
	<section class="relative bg-slate-800 py-32 text-center text-white bg-cover bg-center" style={`background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('${serviceImage}');`}>
		<div class="container mx-auto px-6">
			<h1 class="text-[50px] md:text-[70px] font-black leading-tight mb-4 uppercase tracking-tighter">{niche} {city} MD</h1>
			<h3 class="text-xl md:text-2xl font-bold mb-10 opacity-90 uppercase tracking-[0.2em]">Locally Owned & Professionally Managed in Maryland</h3>
			<a href={`tel:${phone.replace(/-/g, '')}`} class="inline-block bg-white text-[#28657c] font-black text-2xl px-12 py-5 border-2 border-white hover:bg-transparent hover:text-white transition-all uppercase tracking-tighter shadow-2xl">
				CALL NOW {phone}
			</a>
		</div>
	</section>

	<!-- 2. TRUST PILLARS & LEAD CAPTURE (70/30 Split) -->
	<section class="py-20 bg-white">
		<div class="container mx-auto px-6 grid lg:grid-cols-12 gap-16 items-start">
			<div class="lg:col-span-8">
				<h2 class="text-4xl font-black text-[#28657c] mb-12 uppercase tracking-tighter">3 REASONS TO TRUST OUR {city.toUpperCase()} {niche.toUpperCase()} TEAM</h2>
				<div class="space-y-12">
					<div class="flex gap-8 items-start">
						<div class="w-20 h-20 flex-shrink-0 bg-[#28657c]/5 rounded-2xl flex items-center justify-center text-4xl shadow-sm">🛡️</div>
						<div>
							<h4 class="text-xl font-black text-[#28657c] mb-3 uppercase tracking-tight">1. PROLONG THE LIFE OF YOUR SYSTEM</h4>
							<p class="text-slate-600 leading-relaxed italic">"Professional {niche} in {city}, MD will extend the life of your entire infrastructure, protecting your home's value."</p>
							<p class="text-slate-500 mt-2">In the local Maryland area, our specialized soil composition requires strict adherence to maintenance cycles to prevent catastrophic failure.</p>
						
					<div class="flex gap-8 items-start">
						<div class="w-20 h-20 flex-shrink-0 bg-[#28657c]/5 rounded-2xl flex items-center justify-center text-4xl shadow-sm">📸</div>
						<div>
							<h4 class="text-xl font-black text-[#28657c] mb-3 uppercase tracking-tight">3. THE ABUNDANT CLARITY VISUAL AUDIT</h4>
							<p class="text-slate-600 leading-relaxed italic">"We provide a full digital report and visual audit after every visit, offering total transparency on your system's health."</p>
							<p class="text-slate-500 mt-2">Unlike other services that "pump and run," our technicians perform a documented visual inspection of baffles, walls, and structural integrity.</p>
						</div>
					</div>
				
					<div class="flex gap-8 items-start">
						<div class="w-20 h-20 flex-shrink-0 bg-[#28657c]/5 rounded-2xl flex items-center justify-center text-4xl shadow-sm">📸</div>
						<div>
							<h4 class="text-xl font-black text-[#28657c] mb-3 uppercase tracking-tight">3. THE ABUNDANT CLARITY VISUAL AUDIT</h4>
							<p class="text-slate-600 leading-relaxed italic">"We provide a full digital report and visual audit after every visit, offering total transparency on your system's health."</p>
							<p class="text-slate-500 mt-2">Unlike other services that "pump and run," our technicians perform a documented visual inspection of baffles, walls, and structural integrity.</p>
						</div>
					</div>
				</div>
			</div>

			<div class="lg:col-span-4 sticky top-12">
				<div class="bg-slate-50 border-4 border-[#28657c] p-10 shadow-2xl rounded-sm">
					<h3 class="text-2xl font-black text-center text-[#28657c] uppercase mb-8 tracking-tighter">REQUEST A FREE ESTIMATE</h3>
					<form id="leadForm" class="space-y-5">
						<input type="text" name="name" required placeholder="YOUR NAME" class="w-full border-2 border-slate-200 p-4 font-bold outline-[#28657c] transition-all focus:border-[#28657c] uppercase" />
						<input type="tel" name="phone" required placeholder="PHONE NUMBER" class="w-full border-2 border-slate-200 p-4 font-bold outline-[#28657c] transition-all focus:border-[#28657c] uppercase" />
						<input type="text" name="zip" required placeholder="ZIP CODE (E.G. 21131)" class="w-full border-2 border-slate-200 p-4 font-bold outline-[#28657c] transition-all focus:border-[#28657c] uppercase" />
						<textarea name="service" required placeholder="TELL US WHAT YOU NEED..." class="w-full border-2 border-slate-200 p-4 font-bold h-32 outline-[#28657c] transition-all focus:border-[#28657c] uppercase"></textarea>
						<button type="submit" class="w-full bg-[#28657c] text-white py-5 font-black text-xl uppercase tracking-widest hover:bg-[#1e4e5e] transition-all shadow-xl active:scale-95">GET YOUR QUOTE</button>
					</form>
					<p id="formStatus" class="text-[11px] text-slate-400 mt-6 text-center uppercase font-black tracking-widest">100% SATISFACTION GUARANTEED</p>
				</div>
			</div>

			</div>
		</div>
	</section>

	<!-- 3. THE 4-STEP PROCESS (Golden Template Standard) -->
	<section class="py-24 bg-slate-50 border-t border-slate-100">
		<div class="container mx-auto px-6 max-w-5xl">
			<div class="text-center mb-20">
				<h2 class="text-5xl font-[900] text-[#28657c] uppercase tracking-tighter mb-4">OUR {city.toUpperCase()} MD {niche.toUpperCase()} PROCESS</h2>
				<hr class="w-24 border-b-8 border-[#28657c] mx-auto mt-6" />
			</div>

			<div class="grid md:grid-cols-4 gap-4">
				<div class="bg-white p-8 border border-slate-200 shadow-sm relative overflow-hidden group hover:border-[#28657c] transition-all">
					<div class="text-6xl font-black text-slate-100 absolute -right-2 -top-2 group-hover:text-[#28657c]/10 transition-colors">01</div>
					<h5 class="font-black text-[#28657c] uppercase mb-4 relative z-10">LOCATE & INSPECT</h5>
					<p class="text-sm text-slate-500 relative z-10 leading-relaxed">Using specialized electronic probes to locate your tank and minimize any yard disturbance at your {city} property.</p>
				</div>
				<div class="bg-white p-8 border border-slate-200 shadow-sm relative overflow-hidden group hover:border-[#28657c] transition-all">
					<div class="text-6xl font-black text-slate-100 absolute -right-2 -top-2 group-hover:text-[#28657c]/10 transition-colors">02</div>
					<h5 class="font-black text-[#28657c] uppercase mb-4 relative z-10">EXTRACTION</h5>
					<p class="text-sm text-slate-500 relative z-10 leading-relaxed">Our industrial high-power trucks perform a complete extraction of all solids and liquids from the system.</p>
				</div>
				<div class="bg-white p-8 border border-slate-200 shadow-sm relative overflow-hidden group hover:border-[#28657c] transition-all">
					<div class="text-6xl font-black text-slate-100 absolute -right-2 -top-2 group-hover:text-[#28657c]/10 transition-colors">03</div>
					<h5 class="font-black text-[#28657c] uppercase mb-4 relative z-10">VISUAL AUDIT</h5>
					<p class="text-sm text-slate-500 relative z-10 leading-relaxed">A technician performs a deep visual audit of baffles, tank walls, and system integrity to prevent future failures.</p>
				</div>
				<div class="bg-white p-8 border border-slate-200 shadow-sm relative overflow-hidden group hover:border-[#28657c] transition-all">
					<div class="text-6xl font-black text-slate-100 absolute -right-2 -top-2 group-hover:text-[#28657c]/10 transition-colors">04</div>
					<h5 class="font-black text-[#28657c] uppercase mb-4 relative z-10">CLOSURE</h5>
					<p class="text-sm text-slate-500 relative z-10 leading-relaxed">The system is secured and we provide a full DigiiState digital certification and maintenance report.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- 4. INDUSTRIAL AUTHORITY TEXT (Abundant Clarity Standard: 1,100+ Words) -->
	<section class="py-24 bg-white">
		<div class="container mx-auto px-6 max-w-4xl">
			<div class="prose prose-slate prose-lg max-w-none">
				<h2 class="text-4xl font-black text-[#28657c] uppercase tracking-tighter mb-8">Professional Tree Removal Excellence in Severna Park Maryland</h2>
				<p>
					When it comes to maintaining your property's infrastructure in Severna Park, Maryland, you cannot afford to take shortcuts. Unlike the big national franchises that use generic call centers, our Tree Removal team is based right here in Severna Park. We understand the specific soil and climate conditions of Maryland, and we know exactly how they affect your property.
				</p>

                <h3 class="text-3xl font-black text-[#28657c] uppercase tracking-tighter mb-6">Expert Arboriculture & Precision Engineering in Severna Park</h3>
				<p>
					Tree Removal in Severna Park, MD is a complex operation that combines biological knowledge with mechanical physics. Our Maryland licensed tree experts understand the unique structural characteristics of local hardwoods like Oaks, Maples, and Poplars. When a tree becomes a hazard due to disease or storm damage, we utilize advanced rigging and crane techniques to perform a surgical removal.
				</p>
                <p>
                    The dense residential layouts in areas like Severna Park and Severna Park mean there is often zero margin for error. We prioritize the protection of your home's roof, power lines, and landscaping. Every Tree Removal operation begins with a comprehensive site audit where we calculate fall zones and rigging points to ensure a 100% safe execution on your Maryland property.
                </p>

                <h3 class="text-3xl font-black text-[#28657c] uppercase tracking-tighter mb-6">Maryland Licensed Tree Expert Standards</h3>
                <p>
                    In the state of Maryland, performing tree work for compensation requires a specific license from the DNR. This law exists to protect Severna Park homeowners from "fly-by-night" operators who lack proper training and insurance. Our team is fully licensed and carries specialized liability and workers' compensation coverage tailored for high-risk arboriculture. Choosing an unlicensed service in Severna Park puts you at significant financial and legal risk.
                </p>

                <div class="bg-[#28657c]/5 p-12 rounded-3xl my-16 border-l-8 border-[#28657c]">
                    <h4 class="text-2xl font-black text-[#28657c] uppercase mb-6">Severna Park Tree Hazard Checklist</h4>
                    <ul class="space-y-4 font-bold text-slate-700">
                        <li>[ ] TRUNK CAVITIES: Hollow spots or large holes are signs of internal structural failure.</li>
                        <li>[ ] FUNGAL GROWTH: Mushrooms at the base indicate root rot and instability in your Severna Park yard.</li>
                        <li>[ ] LEANING ALIGNMENT: Sudden changes in a tree's lean require immediate professional audit.</li>
                        <li>[ ] DEAD CANOPY: Brittle, leaf-less branches are high-risk fall hazards during Maryland storms.</li>
                        <li>[ ] CO-DOMINANT STEMS: "V-shaped" unions are prone to splitting under wind or snow loads.</li>
                    </ul>
                </div>

                <h3 class="text-3xl font-black text-[#28657c] uppercase tracking-tighter mb-6">Post-Removal Site Restoration</h3>
                <p>
                    A professional Tree Removal isn't finished until the site is restored. We offer comprehensive stump grinding services that turn a hazardous stump into valuable mulch for your Severna Park garden. Our debris management process is thorough—we utilize industrial chippers to process all branches, ensuring your Maryland property is cleaner when we leave than when we arrived. 
                </p>

                <h2 class="text-4xl font-black text-[#28657c] uppercase tracking-tighter mt-24 mb-12">Frequently Asked Questions</h2>
                <div class="space-y-10">
                    <div>
                        <h4 class="text-xl font-black text-slate-900 uppercase mb-2">Do I need a permit for Tree Removal in Severna Park, MD?</h4>
                        <p class="text-slate-600">Local regulations vary by county and municipality. Some areas of Severna Park have strict "Critical Area" rules near the water. We handle the entire permitting and compliance process for our Maryland clients.</p>
                    </div>
                    <div>
                        <h4 class="text-xl font-black text-slate-900 uppercase mb-2">What is the best time of year for tree work?</h4>
                        <p class="text-slate-600">While emergency removals happen year-round in Severna Park, dormant season (late fall and winter) is often best for structural pruning to minimize stress on the trees and your lawn.</p>
                    </div>
                    <div>
                        <h4 class="text-xl font-black text-slate-900 uppercase mb-2">Is Tree Removal expensive in Severna Park?</h4>
                        <p class="text-slate-600">Pricing depends on tree size, location, and complexity. We provide transparent, written estimates and offer tiered options to fit your budget while maintaining Maryland safety standards.</p>
                    </div>
                    <div>
                        <h4 class="text-xl font-black text-slate-900 uppercase mb-2">Will my power lines be affected?</h4>
                        <p class="text-slate-600">We work in coordination with BGE and local utilities in Severna Park to ensure safe clearance around power lines. Never attempt to prune trees near lines yourself; it is extremely dangerous.</p>
                    </div>
                </div>
    

                <h3 class="text-3xl font-black text-[#28657c] uppercase tracking-tighter mb-6">Maryland Community Stewardship</h3>
                <p>
                    As a locally managed service in Severna Park, MD, we are more than just a business; we are part of the Maryland community. We prioritize hiring local technicians who understand the specific challenges of our region, from the humidity of the Chesapeake to the rocky soils of Northern Baltimore County. Our goal is to provide sustainable, reliable infrastructure maintenance that keeps Maryland properties safe and profitable for decades to come.
                </p>
                <p>
                    By choosing our professional services, you are supporting a network dedicated to "Abundant Clarity" in the service industry. We believe that every property owner in Severna Park deserves a transparent, data-driven approach to maintenance. Whether it is protecting your home's foundation or ensuring the safety of your trees, we are here to serve our Maryland neighbors with excellence and integrity.
                </p>
    
			</div>
		</div>
	</section>

	<!-- 5. HYPER-LOCAL SERVICE AREA FOOTER -->
	<section class="py-16 bg-slate-950 text-slate-500">
		<div class="container mx-auto px-6 text-center">
			<h5 class="text-[10px] font-black uppercase tracking-[0.4em] mb-10 text-white opacity-40">Maryland Service Region Coverage</h5>
			<div class="flex flex-wrap justify-center gap-x-8 gap-y-4 text-[10px] font-bold uppercase tracking-widest leading-loose">
				<span>Phoenix</span> <span>Clarksville</span> <span>Hunt Valley</span> <span>Monkton</span> <span>Sparks</span> <span>Cockeysville</span> <span>Timonium</span> <span>Towson</span> <span>Ellicott City</span> <span>Columbia</span> <span>Gibson Island</span> <span>Annapolis</span> <span>Severna Park</span> <span>Arnold</span> <span>Howard County</span> <span>Baltimore County</span> <span>Anne Arundel County</span>
			</div>
		</div>
	</section>
</Layout>

<script is:inline>
	const form = document.getElementById('leadForm');
	const status = document.getElementById('formStatus');
	const webhookUrl = "https://wandering-king-6c05.empty-math-6c0f.workers.dev";

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const formData = new FormData(form);
		const data = Object.fromEntries(formData.entries());
		
		data.source = window.location.hostname;
		data.timestamp = new Date().toISOString();

		try {
			status.textContent = "SENDING REQUEST...";
			const response = await fetch(webhookUrl, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(data)
			});

			if (response.ok) {
				status.textContent = "✅ SUCCESS! WE WILL CALL YOU SHORTLY.";
				form.reset();
			} else {
				throw new Error();
			}
		} catch (err) {
			status.textContent = "❌ ERROR SENDING. PLEASE CALL US NOW.";
		}
	});
</script>
